+
+/* Adega: the launcher passes per-program argument fixes in ADEGA_APPEND_ARGS as
+ * "name.exe|arguments to append|substring that disables the rule;...". The name is
+ * matched case-insensitively against the executable's file name. Returns a new heap
+ * command line, or NULL when no rule applies. */
+static WCHAR *adega_append_args( const WCHAR *app_name, const WCHAR *cmd_line )
+{
+    WCHAR rules[4096], *rule, *next, *append, *forbidden, *ret;
+    const WCHAR *base = wcsrchr( app_name, '\\' );
+    DWORD len = GetEnvironmentVariableW( L"ADEGA_APPEND_ARGS", rules, ARRAY_SIZE(rules) );
+    SIZE_T size;
+
+    if (!len || len >= ARRAY_SIZE(rules)) return NULL;
+    base = base ? base + 1 : app_name;
+    for (rule = rules; rule; rule = next)
+    {
+        if ((next = wcschr( rule, ';' ))) *next++ = 0;
+        if (!(append = wcschr( rule, '|' ))) continue;
+        *append++ = 0;
+        if ((forbidden = wcschr( append, '|' ))) *forbidden++ = 0;
+        if (lstrcmpiW( base, rule )) continue;
+        if (forbidden && *forbidden && wcsstr( cmd_line, forbidden )) return NULL;
+        if (wcsstr( cmd_line, append )) return NULL;
+        size = lstrlenW( cmd_line ) + lstrlenW( append ) + 2;
+        if (!(ret = RtlAllocateHeap( GetProcessHeap(), 0, size * sizeof(WCHAR) ))) return NULL;
+        swprintf( ret, size, L"%s %s", cmd_line, append );
+        TRACE( "adega: %s -> %s\n", debugstr_w(cmd_line), debugstr_w(ret) );
+        return ret;
+    }
+    return NULL;
 }
 
